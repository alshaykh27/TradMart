# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or the real service-role key.

# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public (publishable/anon) key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service-role) key. SERVER-SIDE ONLY. Never prefix with
# NEXT_PUBLIC_ and never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to authenticate Safka product webhooks (?token=...). SERVER-SIDE
# ONLY. A 48-char URL-safe token. Generate one with:
#   node -e "process.stdout.write(require('crypto').randomBytes(36).toString('base64url'))"
WEBHOOK_SECRET=

# Safka Public API base URL and key. SERVER-SIDE ONLY.
SAFKA_API_BASE_URL=
SAFKA_API_KEY=

# Forward placed orders to the Safka Public API. Defaults to disabled: unless
# this is exactly "true", nothing is sent and the payload that WOULD be sent is
# logged instead (for review). SERVER-SIDE ONLY.
SAFKA_ORDERS_ENABLED=false

# Optional. Vercel sends this as a Bearer token on cron invocations; the hourly
# governorate-price-list sync (app/api/cron/sync-governorates) rejects callers
# that do not match. SERVER-SIDE ONLY. Generate one like WEBHOOK_SECRET:
#   node -e "process.stdout.write(require('crypto').randomBytes(36).toString('base64url'))"
CRON_SECRET=

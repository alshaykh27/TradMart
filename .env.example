# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or the real service-role key.

# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public (publishable/anon) key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service-role) key. SERVER-SIDE ONLY. Never prefix with
# NEXT_PUBLIC_ and never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
